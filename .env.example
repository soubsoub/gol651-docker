# =============================================================================
# GOL651 - Environment configuration
# =============================================================================
# 1. Copy this file to .env            (macOS/Linux: cp .env.example .env)
#                                      (Windows PowerShell: Copy-Item .env.example .env)
# 2. Change the two passwords below.
# 3. Never commit .env to Git (it is listed in .gitignore).
#
# Use simple values: letters, digits, "_" and "-" only, no spaces or quotes.
# =============================================================================

# --- MySQL credentials ---------------------------------------------------------
# Course convention: keep MYSQL_DATABASE and MYSQL_USER equal to "gol651".
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=gol651
MYSQL_USER=gol651
MYSQL_PASSWORD=change_me_student_password

# --- Host ports (change only the value if a port is already in use) -----------
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
JUPYTER_PORT=8888
MARIMO_PORT=2718
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
FLASK_PORT=5000

# --- Network exposure ----------------------------------------------------------
# 127.0.0.1 = services are reachable ONLY from this computer (recommended).
# Jupyter and Marimo run WITHOUT a password: never use 0.0.0.0 on a network
# you do not control.
BIND_ADDRESS=127.0.0.1

# --- Linux only: owner of the files created in your project folders --------------
# Windows and macOS (Docker Desktop): leave everything below unchanged.
# Linux: if "id -u" prints 1000, leave it unchanged too (the ready-made image
# uses 1000). Otherwise: set LOCAL_UID / LOCAL_GID to the output of "id -u"
# and "id -g", uncomment the COMPOSE_FILE line, then run: docker compose build
LOCAL_UID=1000
LOCAL_GID=1000
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
