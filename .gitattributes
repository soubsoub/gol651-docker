# Normalize line endings in the repository.
* text=auto

# Files executed inside Linux containers MUST keep LF endings, even when the
# repository is cloned on Windows (CRLF breaks "#!/bin/sh" scripts).
*.sh        text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env.example text eol=lf

# PowerShell scripts (Stage 2) keep Windows endings.
*.ps1       text eol=crlf
