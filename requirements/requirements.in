# =============================================================================
# GOL651 - Direct Python dependencies (Python 3.12)
# =============================================================================
# This file lists ONLY the packages the course uses directly.
# The exact, reproducible environment is requirements-lock.txt, generated with:
#
#   uv pip compile requirements/requirements.in \
#     --universal --python-version 3.12 \
#     -o requirements/requirements-lock.txt
#
# Version policy:
#   - lower bound = version validated at the start of the semester;
#   - upper bound = next major version (breaking changes are excluded);
#   - the Docker image installs requirements-lock.txt, never this file.
# Never edit requirements-lock.txt by hand.
# =============================================================================

